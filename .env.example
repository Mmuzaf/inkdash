# Copy to .env and fill in. Never commit the real values.
#
# Read automatically on startup, whether inkdash runs from the CLI, the server or docker.
# Variables already present in the environment are left alone, so exporting one in your
# shell still overrides what is written here.

# Base URL of your Home Assistant instance. Overrides home_assistant.url in config.yaml,
# so the same config can be deployed against a different instance.
HA_URL=http://homeassistant.local:8123

# Long-lived access token, created under your Home Assistant profile > Security.
HA_TOKEN=

# How often the server re-renders, and how soon it retries a failed cycle. Both override
# dashboard.render_interval_seconds and dashboard.render_retry_seconds in config.yaml, so a
# deployment can render less often than a checked-in config asks for. Leave blank to use
# the configured values.
INKDASH_RENDER_INTERVAL_SECONDS=
INKDASH_RENDER_RETRY_SECONDS=

# Only needed once the OpenSearch provider lands.
OPENSEARCH_URL=
